{
  "name": "connect-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "server",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=server && npm run build --workspace=frontend",
    "start": "npm run start --workspace=server",
    "prisma:generate": "npm run prisma:generate --workspace=server",
    "prisma:seed": "npm run prisma:seed --workspace=server"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
