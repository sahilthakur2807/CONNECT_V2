{
  "name": "connect-rebuilt-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:host": "concurrently \"npm run dev --workspace=server\" \"npm run dev:host --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "prisma:generate": "npm run prisma:generate --workspace=server",
    "prisma:seed": "npm run prisma:seed --workspace=server",
    "prisma:migrate": "npm run prisma:migrate --workspace=server",
    "test": "npm run test --workspace=server && npm run test --workspace=client"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
